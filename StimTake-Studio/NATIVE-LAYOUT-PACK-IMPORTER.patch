+                {
+                    MessageBox.Show("No previous Layout Pack recovery backup exists yet.");
+                    return;
+                }
+
+                Array.Sort(backups, StringComparer.OrdinalIgnoreCase);
+                string previous = backups[backups.Length - 1];
